<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PingYi.App.ImageAnalysisConsentWindow" Classes="workspace"
        Title="{DynamicResource String.VisionConsentTitle}" Width="620" Height="440" MinWidth="460" MinHeight="360"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
  <Window.Styles><StyleInclude Source="avares://PingYi.App/Styles/Workspace.axaml"/></Window.Styles>
  <Grid Margin="24" RowDefinitions="Auto,*,Auto" RowSpacing="16">
    <TextBlock Text="{DynamicResource String.VisionConsentTitle}" Classes="workspace-title"/>
    <ScrollViewer Grid.Row="1" Classes="workspace-page">
      <StackPanel Spacing="14" Margin="0,0,6,6">
        <TextBlock Text="{DynamicResource String.VisionConsentBody}" Classes="workspace-help"/>
        <Border Classes="workspace-inset">
          <StackPanel Spacing="6">
            <TextBlock Text="{DynamicResource String.VisionDestination}" Classes="workspace-label"/>
            <TextBlock x:Name="DestinationText" Classes="workspace-help"/>
            <TextBlock x:Name="ModelText" Classes="workspace-help"/>
          </StackPanel>
        </Border>
        <TextBlock Text="{DynamicResource String.VisionConsentHint}" Classes="workspace-help"/>
      </StackPanel>
    </ScrollViewer>
    <WrapPanel Grid.Row="2" HorizontalAlignment="Right">
      <Button x:Name="RejectButton" Classes="secondary" Content="{DynamicResource String.VisionDoNotSend}" Click="Cancel_OnClick" Margin="0,0,8,8"/>
      <Button x:Name="ConfirmButton" Classes="secondary" Content="{DynamicResource String.VisionSendOnce}" Click="Confirm_OnClick" Margin="0,0,8,8"/>
      <Button x:Name="RememberButton" Classes="primary" Content="{DynamicResource String.VisionRememberConsent}" Click="Remember_OnClick" Margin="0,0,8,8"/>
    </WrapPanel>
  </Grid>
</Window>
