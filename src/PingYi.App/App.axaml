<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PingYi.App.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://PingYi.App/Localization/Strings.zh-CN.axaml" />
        <ResourceInclude Source="avares://PingYi.App/Styles/ApplePalette.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <Style Selector="Window">
      <Setter Property="Background" Value="{DynamicResource PageBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
      <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI, PingFang SC, Noto Sans CJK SC, avares://Avalonia.Fonts.Inter/Assets#Inter" />
    </Style>

    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="20" />
      <Setter Property="BoxShadow" Value="0 2 8 0 #08000000" />
    </Style>

    <Style Selector="Border.subtle-card">
      <Setter Property="Background" Value="{DynamicResource SubtleBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="14" />
    </Style>

    <Style Selector="Border.inline-status">
      <Setter Property="Background" Value="{DynamicResource SubtleBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="11,9" />
    </Style>

    <Style Selector="Border.chip">
      <Setter Property="Background" Value="{DynamicResource SubtleBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Padding" Value="10,5" />
    </Style>

    <Style Selector="Button">
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="15,9" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource ActionFillBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ActionFillBrush}" />
      <Setter Property="Foreground" Value="White" />
    </Style>

    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BrandHoverBrush}" />
    </Style>

    <Style Selector="Button.cta">
      <Setter Property="Background" Value="{DynamicResource ActionBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ActionBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="MinHeight" Value="50" />
      <Setter Property="Padding" Value="20,12" />
      <Setter Property="FontSize" Value="15" />
    </Style>

    <Style Selector="Button.cta:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ActionHoverBrush}" />
    </Style>

    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="{DynamicResource SubtleBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    </Style>

    <Style Selector="Button.secondary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}" />
    </Style>

    <Style Selector="Button.model-installed">
      <Setter Property="Background" Value="{DynamicResource SuccessBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource SuccessTextBrush}" />
    </Style>

    <Style Selector="Button.feedback-loading">
      <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BrandBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource BrandBrush}" />
    </Style>

    <Style Selector="Button.feedback-success">
      <Setter Property="Background" Value="{DynamicResource SuccessBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource SuccessTextBrush}" />
    </Style>

    <Style Selector="Button.feedback-success:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SuccessBackgroundBrush}" />
    </Style>

    <Style Selector="Button.feedback-error">
      <Setter Property="Background" Value="{DynamicResource WarningBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}" />
    </Style>

    <Style Selector="Button.feedback-error:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource WarningBackgroundBrush}" />
    </Style>

    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    </Style>

    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}" />
    </Style>

    <Style Selector="Button.danger-ghost">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    </Style>

    <Style Selector="Button.danger-ghost:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#14DC2626" />
    </Style>

    <Style Selector="Button:focus">
      <Setter Property="BorderBrush" Value="{DynamicResource FocusRingBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>

    <Style Selector="Button:disabled">
      <Setter Property="Opacity" Value="0.5" />
    </Style>

    <Style Selector="Button.feedback-loading:disabled">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="Button.model-installed:disabled">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="ToggleButton.pin">
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="13,8" />
      <Setter Property="Background" Value="{DynamicResource SubtleBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    </Style>

    <Style Selector="ToggleButton.pin:checked">
      <Setter Property="Background" Value="{DynamicResource ActionFillBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ActionFillBrush}" />
      <Setter Property="Foreground" Value="White" />
    </Style>

    <Style Selector="ToggleButton.pin:focus">
      <Setter Property="BorderBrush" Value="{DynamicResource FocusRingBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>

    <Style Selector="TextBox, ComboBox">
      <Setter Property="MinHeight" Value="42" />
      <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="FontSize" Value="13" />
    </Style>

    <Style Selector="TextBox:focus, ComboBox:focus">
      <Setter Property="BorderBrush" Value="{DynamicResource BrandBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>

    <Style Selector="TextBox.result-text">
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="LineHeight" Value="23" />
    </Style>

    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    </Style>

    <Style Selector="TextBlock.tertiary">
      <Setter Property="Foreground" Value="{DynamicResource TertiaryTextBrush}" />
    </Style>

    <Style Selector="TextBlock.eyebrow">
      <Setter Property="Foreground" Value="{DynamicResource BrandBrush}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="LetterSpacing" Value="1.2" />
    </Style>

    <Style Selector="TextBlock.section-title">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.field-label">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    </Style>

    <Style Selector="PathIcon.icon">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
    </Style>

    <Style Selector="Separator">
      <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
    </Style>
  </Application.Styles>
</Application>
