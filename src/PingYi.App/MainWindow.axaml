<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:PingYi.App" x:Class="PingYi.App.MainWindow" Classes="workspace" Title="{DynamicResource Text.3a57aee6d162}" Icon="avares://PingYi.App/Assets/pingyi-v2-icon.png" Width="1040" Height="720" MinWidth="800" MinHeight="560" KeyDown="Workspace_OnKeyDown" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <SolidColorBrush x:Key="TealBrush">#2C9A5E</SolidColorBrush>
    <SolidColorBrush x:Key="OrangeBrush">#BB771E</SolidColorBrush>
    <SolidColorBrush x:Key="SuccessBrushV2">#2C9A5E</SolidColorBrush>
    <SolidColorBrush x:Key="DangerBrushV2">#D74750</SolidColorBrush>
  </Window.Resources>
  <Window.Styles>
    <StyleInclude Source="avares://PingYi.App/Styles/Workspace.axaml"/>
  </Window.Styles>
  <Grid RowDefinitions="76,*,Auto">
    <Grid Margin="32,20,32,16" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
      <Image Source="avares://PingYi.App/Assets/pingyi-v2-icon-512.png" Width="34" Height="34"/>
      <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
        <TextBlock Text="{DynamicResource String.AppName}" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock Text="{DynamicResource Workspace.Reading}" Classes="workspace-help" FontSize="12"/>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
          <Border x:Name="TopStatusDot" Width="6" Height="6" CornerRadius="3" Background="{DynamicResource TealBrush}" VerticalAlignment="Center"/>
          <TextBlock x:Name="TopStatusText" Text="{DynamicResource Text.d85ff08f9141}" Classes="workspace-help" FontSize="12" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
        <Button x:Name="HelpButton" Classes="toolbar-action" Content="{DynamicResource String.HelpTitle}" Click="OpenHelp_OnClick"/>
        <Button Classes="toolbar-action" Click="OpenSettingsButton_OnClick" ToolTip.Tip="Ctrl+," AutomationProperties.Name="{DynamicResource Text.f2eabda76179}">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <Path Classes="symbol" Width="15" Height="15" Stroke="{DynamicResource SecondaryTextBrush}" Data="M4 5H20 M4 12H20 M4 19H20 M8 2V8 M16 9V15 M10 16V22"/>
            <TextBlock Text="{DynamicResource Workspace.Settings}" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>
    <ScrollViewer Grid.Row="1" Classes="workspace-page">
      <StackPanel Margin="32,6,32,20" Spacing="14">
        <Border Classes="workspace-card" Padding="28,14" CornerRadius="24" Background="{DynamicResource HeroBackgroundBrush}">
          <Grid ColumnDefinitions="1.3*,*" ColumnSpacing="24">
            <StackPanel Spacing="10" VerticalAlignment="Center" MaxWidth="400" HorizontalAlignment="Left">
              <TextBlock Text="{DynamicResource Polish.CaptureShortTitle}" FontSize="28" LineHeight="35" FontWeight="SemiBold" LetterSpacing="-0.5" TextWrapping="Wrap"/>
              <TextBlock Text="{DynamicResource Polish.CaptureShortHint}" Classes="workspace-help" FontSize="12" MaxWidth="370" HorizontalAlignment="Left"/>
              <Button x:Name="CaptureButtonV2" Classes="workspace-capture" HorizontalAlignment="Stretch" Margin="0,4,0,0" Click="CaptureButton_OnClick" AutomationProperties.Name="{DynamicResource Text.87053eb04e5a}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                  <Path Classes="symbol" Stroke="White" Data="M3 8V3H8 M16 3H21V8 M21 16V21H16 M8 21H3V16"/>
                  <TextBlock Grid.Column="1" Text="{DynamicResource String.StartCapture}" VerticalAlignment="Center"/>
                  <Border Grid.Column="2" Background="#24FFFFFF" CornerRadius="5" Padding="7,4">
                    <TextBlock x:Name="CaptureHotkeyText" Text="Ctrl  Alt  D" FontSize="11" VerticalAlignment="Center"/>
                  </Border>
                </Grid>
              </Button>
              <TextBlock Text="{DynamicResource Polish.CaptureCancelHint}" Classes="workspace-help" FontSize="11" LineHeight="16"/>
            </StackPanel>
            <!-- Original static vector illustration; no user content or rendering loop. -->
            <Viewbox Grid.Column="1" MaxWidth="220" Stretch="Uniform" Margin="0,4,6,0" IsHitTestVisible="False">
              <Grid Width="264" Height="206">
                <Border Width="190" Height="190" CornerRadius="95" Background="{DynamicResource HeroAccentBrush}" Opacity="0.45" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Border Width="134" Height="142" Margin="13,9,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="19" Background="{DynamicResource HeroPaperBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" BoxShadow="0 7 18 0 #0B102A50" RenderTransformOrigin="50%,50%">
                  <Border.RenderTransform>
                    <RotateTransform Angle="-8"/>
                  </Border.RenderTransform>
                  <StackPanel Margin="21,15" Spacing="10">
                    <TextBlock Text="A" FontSize="42" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <Border Height="5" CornerRadius="2" Background="{DynamicResource HeroLineBrush}"/>
                    <Border Height="5" Width="64" HorizontalAlignment="Left" CornerRadius="2" Background="{DynamicResource HeroLineBrush}"/>
                  </StackPanel>
                </Border>
                <Border Width="134" Height="138" Margin="0,0,11,6" HorizontalAlignment="Right" VerticalAlignment="Bottom" CornerRadius="21" Background="{DynamicResource ActionFillBrush}" BorderBrush="#40FFFFFF" BorderThickness="1" BoxShadow="0 10 20 0 #16065BB8" RenderTransformOrigin="50%,50%">
                  <Border.RenderTransform>
                    <RotateTransform Angle="7"/>
                  </Border.RenderTransform>
                  <StackPanel Margin="21,14" Spacing="10">
                    <TextBlock Text="文" FontSize="38" FontWeight="SemiBold" Foreground="White"/>
                    <Border Height="5" CornerRadius="2" Background="#70FFFFFF"/>
                    <Border Height="5" Width="56" HorizontalAlignment="Left" CornerRadius="2" Background="#40FFFFFF"/>
                  </StackPanel>
                </Border>
                <Border Width="38" Height="38" CornerRadius="19" Margin="108,76,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{DynamicResource HeroPaperBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" BoxShadow="0 3 9 0 #13000000">
                  <Path Classes="symbol" Width="16" Height="16" Data="M4 7H20 M15 3L20 7L15 11 M20 17H4 M9 13L4 17L9 21"/>
                </Border>
              </Grid>
            </Viewbox>
          </Grid>
        </Border>
        <Border Classes="workspace-card" Padding="22,16" CornerRadius="16">
          <Grid RowDefinitions="Auto,Auto" RowSpacing="14">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
              <TextBlock Text="{DynamicResource Workspace.ProcessLabel}" Classes="workspace-help" FontSize="12" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" TextWrapping="Wrap" x:Name="ModeSummaryText" Text="{DynamicResource Text.085931b25c71}" Classes="workspace-label" VerticalAlignment="Center"/>
              <Button Grid.Column="2" x:Name="ChooseModeButton" Classes="toolbar-action" MinHeight="34" Padding="14,6"
                      Content="{DynamicResource String.ChooseMode}" Click="ChooseMode_OnClick"/>
            </Grid>
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto,*" ColumnSpacing="22">
              <StackPanel Spacing="4">
                <TextBlock Text="{DynamicResource Text.5fd5df38157d}" Classes="workspace-help" FontSize="12"/>
                <TextBlock x:Name="OcrSummaryText" Text="{DynamicResource Text.c5b809959cde}" Classes="workspace-section"/>
                <TextBlock x:Name="OcrHealthText" Text="{DynamicResource String.CheckPending}" Classes="workspace-help" FontSize="12"/>
              </StackPanel>
              <Path Grid.Column="1" Classes="symbol" Stroke="{DynamicResource TertiaryTextBrush}" Width="24" Data="M3 12H21 M16 7L21 12L16 17"/>
              <StackPanel Grid.Column="2" Spacing="4">
                <TextBlock Text="{DynamicResource Text.da4ace1c0a46}" Classes="workspace-help" FontSize="12"/>
                <TextBlock x:Name="TranslationSummaryText" Text="{DynamicResource Text.955983eac341}" Classes="workspace-section"/>
                <TextBlock x:Name="TranslationHealthText" Text="{DynamicResource String.CheckPending}" Classes="workspace-help" FontSize="12"/>
              </StackPanel>
            </Grid>
          </Grid>
        </Border>
        <Border Classes="workspace-card" Padding="18,12" CornerRadius="16">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
            <Border x:Name="ModelStatusDot" Width="7" Height="7" CornerRadius="4" Background="{DynamicResource TealBrush}" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Spacing="4">
              <TextBlock x:Name="ModelStatusTitleText" Text="{DynamicResource String.CheckPending}" Classes="workspace-section"/>
              <TextBlock x:Name="ModelStatusDetailText" Text="{DynamicResource String.BaselineModels}" Classes="workspace-help" FontSize="12" LineHeight="18"/>
            </StackPanel>
            <Button Grid.Column="2" x:Name="RefreshWorkspaceButton" Classes="toolbar-action" Content="{DynamicResource Workspace.Refresh}"
                    Click="RefreshWorkspaceButton_OnClick" ToolTip.Tip="F5" VerticalAlignment="Center"/>
          </Grid>
        </Border>
        <Border x:Name="RecoveryBorder" IsVisible="False" Background="{DynamicResource WarningBackgroundBrush}" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1" CornerRadius="14" Padding="16">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <StackPanel Spacing="4">
              <TextBlock Text="{DynamicResource Text.8bc59928b706}" Classes="workspace-section"/>
              <TextBlock x:Name="RecoveryDetailText" Text="{DynamicResource Text.4aa2ad79923b}" Classes="workspace-help" AutomationProperties.LiveSetting="Assertive"/>
            </StackPanel>
            <Button Grid.Column="1" Classes="secondary" Content="{DynamicResource Text.6f4f62913d52}" VerticalAlignment="Center" Click="RepairButton_OnClick" AutomationProperties.Name="{DynamicResource Text.b46b3d4ca814}"/>
          </Grid>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="32,12,32,16">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
        <Border x:Name="LiveStatusDot" Width="6" Height="6" CornerRadius="3" Background="{DynamicResource TealBrush}" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="1" Spacing="2">
          <TextBlock x:Name="LiveStatusTitleText" Text="{DynamicResource Text.1bd1893c0900}" Classes="workspace-label" FontSize="12"/>
          <TextBlock x:Name="LiveStatusDetailText" Text="{DynamicResource Text.a27e6084e439}" Classes="workspace-help" FontSize="11" LineHeight="17" MaxHeight="51" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Text, RelativeSource={RelativeSource Self}}" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>

