<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:PingYi.App" x:Class="PingYi.App.SettingsWindow"
        Width="1080" Height="820" MinWidth="720" MinHeight="480" Classes="workspace"
        WindowStartupLocation="CenterOwner" KeyDown="Workspace_OnKeyDown" Title="设置 / Settings">
  <Window.Styles><StyleInclude Source="avares://PingYi.App/Styles/Workspace.axaml"/></Window.Styles>
  <Grid RowDefinitions="*,Auto" Margin="20">
    <TabControl x:Name="SettingsTabs" TabStripPlacement="Left">
      <TabItem x:Name="CurrentModelSettingsTab" Header="当前模型" Classes="workspace-tab">
        <ScrollViewer><StackPanel Margin="24" Spacing="16">
          <TextBlock x:Name="CurrentModelTitle" Classes="workspace-title" Text="当前模型"/>
          <TextBlock x:Name="CurrentModelHint" Classes="workspace-help" TextWrapping="Wrap"/>
          <ComboBox x:Name="CurrentModelCombo" Classes="workspace-field" AutomationProperties.Name="Current model"/>
          <Button x:Name="RefreshCurrentModelsButton" Click="RefreshCurrentModels_OnClick" Classes="secondary" HorizontalAlignment="Left"/>
          <TextBlock x:Name="MigrationNoticeText" Classes="workspace-help" TextWrapping="Wrap"/>
          <TextBlock x:Name="TargetLanguageLabel" Classes="workspace-label"/>
          <ComboBox x:Name="TargetLanguageCombo" Classes="workspace-field" AutomationProperties.Name="Translation target language"/>
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem x:Name="CloudSettingsTab" Header="云端 API 管理" Classes="workspace-tab">
        <ScrollViewer><StackPanel Margin="24" Spacing="16"><ContentControl x:Name="CloudEditorHost"/></StackPanel></ScrollViewer>
      </TabItem>
      <TabItem x:Name="LocalSettingsTab" Header="本地模型管理" Classes="workspace-tab">
        <ScrollViewer><StackPanel Margin="24" Spacing="16">
          <TextBlock x:Name="LocalModelHint" Classes="workspace-help" TextWrapping="Wrap"/>
          <ContentControl x:Name="LocalEditorHost"/>
          <Expander x:Name="ManagedModelExpander" Header="{DynamicResource Text.28137e0aafbe}" IsExpanded="True" IsVisible="False">
              <StackPanel Spacing="14" Margin="0,14,0,0">
                <StackPanel Spacing="6">
                  <TextBlock Text="{DynamicResource Text.fe43e358e6d1}" Classes="workspace-label"/>
                  <ComboBox x:Name="ManagedModelCombo" Classes="workspace-field" AutomationProperties.Name="{DynamicResource Text.9a0552ac7454}" SelectionChanged="ManagedModelCombo_OnSelectionChanged"/>
                </StackPanel>
                <StackPanel Spacing="6">
                  <TextBlock Text="{DynamicResource Text.b7600b964f62}" Classes="workspace-label"/>
                  <ComboBox x:Name="ManagedRuntimeBackendCombo" Classes="workspace-field" AutomationProperties.Name="{DynamicResource Text.92a84411fed4}" SelectionChanged="ManagedRuntimeBackendCombo_OnSelectionChanged"/>
                </StackPanel>
                <TextBlock x:Name="ManagedRuntimeBackendHintText" Classes="workspace-help" AutomationProperties.LiveSetting="Polite"/>
                <TextBlock x:Name="ManagedModelSummaryText" Classes="workspace-help" AutomationProperties.LiveSetting="Polite"/>
                <TextBlock x:Name="ManagedModelHardwareText" Classes="workspace-help" AutomationProperties.LiveSetting="Polite"/>
                <ProgressBar x:Name="ManagedModelProgressBar" Minimum="0" Maximum="100" Height="8" Value="0" IsVisible="False"/>
                <TextBlock x:Name="ManagedModelStatusText" Text="{DynamicResource Text.21a71618bad2}" Classes="workspace-help" AutomationProperties.LiveSetting="Polite"/>
                <WrapPanel>
                  <Button x:Name="ManagedModelSourceButton" Content="{DynamicResource Text.a1573c4da535}" Classes="ghost" Click="ManagedModelSourceButton_OnClick" AutomationProperties.Name="{DynamicResource Text.a1573c4da535}" Margin="0,0,8,8"/>
                  <Button x:Name="ManagedModelFolderButton" Content="{DynamicResource Text.4e435fe44aef}" Classes="ghost" Click="ManagedModelFolderButton_OnClick" AutomationProperties.Name="{DynamicResource Text.4e435fe44aef}" Margin="0,0,8,8"/>
                  <Button x:Name="ManagedModelCancelButton" Content="{DynamicResource Text.2cd0f3be8738}" Classes="secondary" Click="ManagedModelCancelButton_OnClick" AutomationProperties.Name="{DynamicResource Text.2cd0f3be8738}" Margin="0,0,8,8" IsVisible="False"/>
                  <Button x:Name="ManagedModelStartButton" Content="{DynamicResource Text.5412c737687b}" Classes="secondary" Click="ManagedModelStartButton_OnClick" AutomationProperties.Name="{DynamicResource Text.5412c737687b}" Margin="0,0,8,8"/>
                  <Button x:Name="ManagedModelInstallButton" Content="{DynamicResource Text.cd5aa45e3fef}" Classes="primary" Click="ManagedModelInstallButton_OnClick" AutomationProperties.Name="{DynamicResource Text.cd5aa45e3fef}" Margin="0,0,8,8"/>
                </WrapPanel>
                <TextBlock Text="{DynamicResource Text.7e0abe191612}" Classes="workspace-help"/>
              </StackPanel>
            </Expander>
          <Expander Header="运行状态 / Runtime status" HorizontalAlignment="Stretch"><local:RuntimeStatusView x:Name="RuntimeStatusPage"/></Expander>
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem x:Name="HotkeySettingsTab" Header="快捷键" Classes="workspace-tab">
        <ScrollViewer><StackPanel Margin="24" Spacing="16">
          <TextBox x:Name="HotkeyBox" Classes="workspace-field" AutomationProperties.Name="Capture shortcut"/>
          <Border x:Name="LinuxShortcutHelp" Classes="workspace-inset" IsVisible="False"><StackPanel Spacing="10">
            <TextBlock x:Name="LinuxShortcutHintText" Classes="workspace-help"/>
            <TextBox x:Name="LinuxCaptureCommandBox" Classes="workspace-field" IsReadOnly="True" TextWrapping="Wrap"/>
            <Button x:Name="CopyLinuxCaptureCommandButton" Click="CopyLinuxCaptureCommand_OnClick"/>
          </StackPanel></Border>
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem x:Name="GeneralSettingsTab" Header="通用设置" Classes="workspace-tab">
        <ScrollViewer><StackPanel Margin="24" Spacing="16">
          <TextBlock x:Name="UiLanguageLabel" Classes="workspace-label"/>
          <ComboBox x:Name="UiLanguageCombo" Classes="workspace-field" SelectionChanged="UiLanguageCombo_OnSelectionChanged" AutomationProperties.Name="UI language"/>
          <CheckBox x:Name="StartMinimizedCheckBox" Content="启动时最小化 / Start minimized"/>
          <CheckBox x:Name="CheckForUpdatesCheckBox" Content="检查更新 / Check for updates"/>
          <Button x:Name="CheckUpdatesNowButton" Click="CheckUpdatesNowButton_OnClick" Content="立即检查更新 / Check now"/>
          <Button x:Name="OpenLatestReleaseButton" Click="OpenLatestReleaseButton_OnClick" Content="打开发布页面 / Open releases" IsVisible="False"/>
          <TextBlock x:Name="UpdateStatusText" Classes="workspace-help" TextWrapping="Wrap"/>
        </StackPanel></ScrollViewer>
      </TabItem>
    </TabControl>
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="16" Margin="0,16,0,0">
      <Border x:Name="GlobalStatusBorder" Classes="workspace-inset" MinHeight="50"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
        <Border x:Name="StatusIndicator" Width="8" Height="8" CornerRadius="4" Background="{DynamicResource BrandBrush}"/>
        <TextBlock Grid.Column="1" x:Name="GlobalStatusText" Classes="workspace-help" TextWrapping="Wrap" MaxHeight="76" AutomationProperties.LiveSetting="Polite"/>
      </Grid></Border>
      <Button Grid.Column="1" x:Name="SaveSettingsButton" AutomationProperties.Name="Save and apply" Classes="primary" Content="保存并应用 / Save and apply" Click="SaveButton_OnClick" ToolTip.Tip="Ctrl+S"/>
    </Grid>
  </Grid>
</Window>
