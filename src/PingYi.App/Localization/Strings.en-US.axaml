  <x:String x:Key="Polish.RecognitionGroup">Text recognition</x:String>
  <x:String x:Key="Polish.TranslationGroup">Translation preferences</x:String>
  <x:String x:Key="String.AppName">PingYi</x:String>
  <x:String x:Key="String.AppTagline">Capture, recognize, and translate in one step</x:String>
  <x:String x:Key="String.BaselineModels">Offline baseline model status</x:String>
  <x:String x:Key="String.Cancel">Cancel</x:String>
  <x:String x:Key="String.CheckPending">Not checked yet</x:String>
