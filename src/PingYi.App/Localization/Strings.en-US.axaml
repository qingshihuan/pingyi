  <x:String x:Key="Polish.CaptureCancelHint">Press Esc to cancel a selection</x:String>
  <x:String x:Key="Polish.CaptureShortHint">Select screen text. Let recognition and translation follow.</x:String>
  <x:String x:Key="Polish.CaptureShortTitle">Capture a moment.&#10;Keep reading.</x:String>
