  <x:String x:Key="Text.49e1e6be89fd">翻译结果</x:String>
  <x:String x:Key="Text.4a2df84f92d0">显示 Google Cloud API Key</x:String>
  <x:String x:Key="Text.4a456bc2336f">选择界面语言</x:String>
  <x:String x:Key="Text.4aa2ad79923b">请检查模型或服务配置。</x:String>
  <x:String x:Key="Text.4daf6c2b1b4f">应用服务预设</x:String>
  <x:String x:Key="Text.4e1449e7d5e5">显示</x:String>
  <x:String x:Key="Text.4e435fe44aef">打开模型目录</x:String>
  <x:String x:Key="Text.5159e7c4e585">复制原文和译文</x:String>
  <x:String x:Key="Text.517daccd5094">Esc 取消</x:String>
  <x:String x:Key="Text.520b00e114f7">尚未保存</x:String>
  <x:String x:Key="Text.52e1279ef29c">显示翻译 APP ID</x:String>
  <x:String x:Key="Text.5412c737687b">启动并应用</x:String>
  <x:String x:Key="Text.5850d0183e6c">兼容翻译接口 API Key</x:String>
  <x:String x:Key="Text.5eda20b4e81b">显示兼容接口 API Key</x:String>
  <x:String x:Key="Text.5fd5df38157d">文字识别</x:String>
  <x:String x:Key="Text.63d90d977348">复制</x:String>
  <x:String x:Key="Text.660640f5b06f">正在识别…</x:String>
  <x:String x:Key="Text.69f42967a6d8">百度 OCR API Key</x:String>
  <x:String x:Key="Text.6c6029415834">自定义组合…</x:String>
  <x:String x:Key="Text.6f4f62913d52">立即修复</x:String>
  <x:String x:Key="Text.71456ea2891f">保存并验证 Google 凭据</x:String>
  <x:String x:Key="Text.72a5e7ce2caf">OCR 模型：正在检查…</x:String>
  <x:String x:Key="Text.77bad5f6137e">百度 OCR 与翻译凭据</x:String>
  <x:String x:Key="Text.7e0abe191612">只下载当前选择的 GGUF 与视觉投影文件；下载支持断点续传并强制校验 SHA-256。模型在本机端口 18080 运行，截图和文字不会离开设备。</x:String>
  <x:String x:Key="Text.7ebc37fcf513">多模态 OCR 会发送本次框选图片；127.0.0.1 服务不会离开设备。</x:String>
  <x:String x:Key="Text.80461c2decc5">译文</x:String>
  <x:String x:Key="Text.87053eb04e5a">开始截图识别和翻译</x:String>
  <x:String x:Key="Text.88989b081187">百度翻译密钥</x:String>
  <x:String x:Key="Text.8b6e7cf003a3">Google Cloud OCR 与翻译凭据</x:String>
  <x:String x:Key="Text.8bc59928b706">当前方案需要处理</x:String>
  <x:String x:Key="Text.8ccdcad15f65">本机大模型服务预设</x:String>
  <x:String x:Key="Text.8d767b02e434">文字识别提供商</x:String>
  <x:String x:Key="Text.8f5175f993e2">显示翻译密钥</x:String>
  <x:String x:Key="Text.90b0a90e2226">检查状态</x:String>
  <x:String x:Key="Text.90bd954a5853">模型名</x:String>
  <x:String x:Key="Text.914b460edf64">选择后立即保存并切换界面语言，无需重启；其他未保存输入会保留。</x:String>
  <x:String x:Key="Text.92a84411fed4">选择本机模型使用 CPU 或通用显卡</x:String>
  <x:String x:Key="Text.93be5e37dda7">内容仅在内存中处理</x:String>
  <x:String x:Key="Text.94aebfb0a33b">OCR 凭据：正在检查安全存储…</x:String>
  <x:String x:Key="Text.955983eac341">本地 Argos</x:String>
  <x:String x:Key="Text.966a23e84aed">目标语言</x:String>
  <x:String x:Key="Text.98267fd4ed54">启动后最小化到托盘</x:String>
  <x:String x:Key="Text.9866f869b0bd">正在初始化…</x:String>
  <x:String x:Key="Text.9a0552ac7454">选择一键安装的本机多模态模型</x:String>
  <x:String x:Key="Text.a1573c4da535">查看魔搭来源</x:String>
  <x:String x:Key="Text.a27e6084e439">按 Ctrl+Alt+D 或点击“开始截图”。</x:String>
  <x:String x:Key="Text.a2f2682c6200">兼容大模型模型名</x:String>
  <x:String x:Key="Text.a5088fbb7cd7">翻译目标语言</x:String>
  <x:String x:Key="Text.a7ec01a65f09">保存并应用</x:String>
  <x:String x:Key="Text.adcebe5b3fed">本机多模态 · PaddleOCR + 大模型纠错</x:String>
  <x:String x:Key="Text.add00718540a">本地优先 · PaddleOCR + Argos</x:String>
  <x:String x:Key="Text.b46b3d4ca814">打开设置修复问题</x:String>
  <x:String x:Key="Text.b68a94c0e3fb">启动时检查更新（会访问 GitHub）</x:String>
  <x:String x:Key="Text.b7600b964f62">运行后端</x:String>
  <x:String x:Key="Text.bd1c1838a09f">关闭结果卡</x:String>
  <x:String x:Key="Text.c5b809959cde">本地 PaddleOCR</x:String>
  <x:String x:Key="Text.cd5aa45e3fef">一键下载并配置</x:String>
  <x:String x:Key="Text.cebd8d1bf16d">显示 OCR Secret Key</x:String>
  <x:String x:Key="Text.cec60643bd05">拖动框选文字区域</x:String>
  <x:String x:Key="Text.cf826c0b58ff">选择云端翻译时，只发送识别后的纯文字。</x:String>
  <x:String x:Key="Text.d4b3f49cd2e4">固定</x:String>
  <x:String x:Key="Text.d5a530cfcfb4">云端增强 · 百度 OCR + 百度翻译</x:String>
