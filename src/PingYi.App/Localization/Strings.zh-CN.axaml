<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:Class="PingYi.App.Localization.ChineseStrings">
  <x:String x:Key="Polish.CaptureCancelHint">按 Esc 取消框选</x:String>
  <x:String x:Key="Polish.CaptureShortHint">框选屏幕文字，让识别与翻译自然发生。</x:String>
  <x:String x:Key="Polish.CaptureShortTitle">轻轻一截，&#10;自在阅读。</x:String>
  <x:String x:Key="Polish.DataBoundary">数据与隐私</x:String>
  <x:String x:Key="Polish.RecognitionGroup">文字识别</x:String>
  <x:String x:Key="Polish.TranslationGroup">翻译偏好</x:String>
  <x:String x:Key="String.AppName">屏译</x:String>
  <x:String x:Key="String.AppTagline">截图、识别、翻译，一次完成</x:String>
  <x:String x:Key="String.BaselineModels">离线基础模型状态</x:String>
  <x:String x:Key="String.Cancel">取消</x:String>
  <x:String x:Key="String.CheckPending">尚未检查</x:String>
  <x:String x:Key="String.ChooseMode">选择方案</x:String>
  <x:String x:Key="String.Close">关闭</x:String>
  <x:String x:Key="String.ConfigureCombination">配置自定义组合</x:String>
  <x:String x:Key="String.CopyAll">复制全部</x:String>
  <x:String x:Key="String.CopySource">复制原文</x:String>
  <x:String x:Key="String.CopyTranslation">复制译文</x:String>
  <x:String x:Key="String.CurrentDataRoute">当前配置的数据去向</x:String>
  <x:String x:Key="String.CurrentMode">当前方案</x:String>
  <x:String x:Key="String.HelpHint">使用方法、快捷键，以及当前方案的数据处理范围。</x:String>
  <x:String x:Key="String.HelpTitle">帮助与关于</x:String>
  <x:String x:Key="String.LanguageApplied">界面语言已保存并立即生效；其他输入保持不变。</x:String>
  <x:String x:Key="String.LocalLlmData">当前为本机接口，只向本机回环服务发送文字。</x:String>
  <x:String x:Key="String.LocalVisionData">当前为本机接口，图片与文字发送到本机回环服务。</x:String>
  <x:String x:Key="String.Mode.baidu.Method">百度 OCR 识别 → 百度通用翻译</x:String>
  <x:String x:Key="String.Mode.baidu.Name">百度云服务</x:String>
  <x:String x:Key="String.Mode.baidu.Needs">需要联网及 OCR、翻译两组凭据；所选图片与识别文字会发送到百度，可能产生服务费用。</x:String>
  <x:String x:Key="String.Mode.baidu.Use">适合已开通百度服务的用户，识别与翻译由云端完成。</x:String>
  <x:String x:Key="String.Mode.custom.Method">分别选择 OCR、翻译提供商和目标语言</x:String>
  <x:String x:Key="String.Mode.custom.Name">自定义组合</x:String>
  <x:String x:Key="String.Mode.custom.Needs">打开“识别与翻译”设置；保留现有自定义地址、模型及凭据。</x:String>
  <x:String x:Key="String.Mode.custom.Use">用于 Google Cloud、直接多模态 OCR，或其他本地与云端混合方式。</x:String>
  <x:String x:Key="String.Mode.llm.Method">PaddleOCR 识别 → 已配置的兼容大模型翻译</x:String>
  <x:String x:Key="String.Mode.llm.Name">大模型翻译</x:String>
  <x:String x:Key="String.Mode.llm.Needs">需先配置文字模型与兼容接口。</x:String>
  <x:String x:Key="String.Mode.llm.Use">适合希望改善语句表达的场景；速度、语言覆盖和效果取决于所选模型。</x:String>
  <x:String x:Key="String.Mode.offline.Method">PaddleOCR 识别 → Argos 翻译</x:String>
  <x:String x:Key="String.Mode.offline.Name">离线基础</x:String>
  <x:String x:Key="String.Mode.offline.Needs">全程本机处理；需安装离线基础模型，不需要云端密钥。</x:String>
  <x:String x:Key="String.Mode.offline.Use">适合日常中英取词与基础翻译，无需运行大模型。</x:String>
  <x:String x:Key="String.Mode.vision.Method">PaddleOCR 初稿 + 多模态校对 → 大模型翻译</x:String>
  <x:String x:Key="String.Mode.vision.Name">视觉纠错</x:String>
  <x:String x:Key="String.Mode.vision.Needs">需支持 image_url 的视觉模型与兼容接口。</x:String>
  <x:String x:Key="String.Mode.vision.Use">对小字或特殊字体进行二次校对；需要额外推理时间，不保证表格或公式识别效果。</x:String>
  <x:String x:Key="String.OcrBaiduData">识别：所选图片发送到百度 OCR。</x:String>
  <x:String x:Key="String.OcrGoogleData">识别：所选图片发送到 Google Cloud Vision。</x:String>
  <x:String x:Key="String.OcrLocalData">识别：PaddleOCR 在本机处理图片。</x:String>
  <x:String x:Key="String.OcrLoopbackData">识别：图片发送到配置的本机多模态接口。</x:String>
  <x:String x:Key="String.OcrRemoteData">识别：所选图片发送到配置的远程多模态接口。</x:String>
  <x:String x:Key="String.OnDemand">按需加载 · 截图时检查并启动</x:String>
  <x:String x:Key="String.OpenSettings">打开设置</x:String>
  <x:String x:Key="String.OtherShortcuts">Esc：取消框选。&#10;Ctrl+,：在主界面打开设置。&#10;F5：在主界面刷新状态。&#10;Ctrl+S：在设置窗口保存配置。</x:String>
  <x:String x:Key="String.PickerHint">先看适用场景，再确认处理方式和使用条件。选中不会立即应用。</x:String>
  <x:String x:Key="String.PickerTitle">选择处理方案</x:String>
  <x:String x:Key="String.PrivacyBody">屏译不保存截图、识别正文或译文的历史记录，也不把这些内容或密钥写入日志；显示中的结果会保留在内存中。&#10;&#10;只有选择云端 OCR 时才向对应服务发送所选图片；使用多模态接口时也会发送图片。云端翻译发送识别后的文字。兼容接口是否在本机运行，以实际配置地址为准，本机服务本身的数据处理由其实现决定。&#10;&#10;模型下载、凭据验证和手动检查更新会联网；自动检查更新仅在主动开启后进行。密钥使用系统安全存储；Linux 密钥服务不可用时只保留在当前会话。</x:String>
  <x:String x:Key="String.PrivacyTitle">隐私与数据</x:String>
  <x:String x:Key="String.QuickHelp">快速上手</x:String>
  <x:String x:Key="String.QuickHelpBody">点击“开始截图”或按全局快捷键，拖动框选区域；松开鼠标开始识别与翻译。结果卡支持选择文字、复制原文、复制译文、重新处理和固定。需要其他语言或引擎时，在设置的“识别与翻译”页调整。</x:String>
  <x:String x:Key="String.RemoteLlmData">当前为远程接口，需要联网并发送识别文字。</x:String>
  <x:String x:Key="String.RemoteVisionData">当前为远程接口，需要联网并发送所选图片与文字。</x:String>
  <x:String x:Key="String.Repository">项目与使用文档</x:String>
  <x:String x:Key="String.ResultTitle">识别结果</x:String>
  <x:String x:Key="String.Retry">重新处理</x:String>
  <x:String x:Key="String.SettingsReady">设置已就绪。语言选择立即生效；其他配置请保存并应用。</x:String>
  <x:String x:Key="String.StartCapture">开始截图</x:String>
  <x:String x:Key="String.TranslationBaiduData">翻译：识别文字发送到百度翻译。</x:String>
  <x:String x:Key="String.TranslationGoogleData">翻译：识别文字发送到 Google Cloud Translation。</x:String>
  <x:String x:Key="String.TranslationLocalData">翻译：Argos 在本机处理文字。</x:String>
  <x:String x:Key="String.TranslationLoopbackData">翻译：识别文字发送到配置的本机兼容接口。</x:String>
  <x:String x:Key="String.TranslationRemoteData">翻译：识别文字发送到配置的远程兼容接口。</x:String>
  <x:String x:Key="String.UnknownDataRoute">此提供商的数据范围请在服务配置中确认。</x:String>
  <x:String x:Key="String.UseMode">应用此方案</x:String>
  <x:String x:Key="String.Version">程序版本</x:String>
  <x:String x:Key="Text.01197746a1c6">显示或隐藏</x:String>
  <x:String x:Key="Text.01f61382b4b0">正在处理截图内容</x:String>
  <x:String x:Key="Text.02739d1bae8b">服务地址</x:String>
  <x:String x:Key="Text.0299dc01919c">全局快捷键</x:String>
  <x:String x:Key="Text.032eb48c7a43">复制译文</x:String>
  <x:String x:Key="Text.035be0663f55">Google OCR 凭据：正在检查安全存储…</x:String>
  <x:String x:Key="Text.07dfec93a84e">识别到的原文</x:String>
  <x:String x:Key="Text.085931b25c71">本地优先</x:String>
  <x:String x:Key="Text.0a6515fe343a">刷新模型与服务状态</x:String>
  <x:String x:Key="Text.0af5623919d4">保存并验证凭据</x:String>
  <x:String x:Key="Text.0f66607cd07e">翻译 APP ID</x:String>
  <x:String x:Key="Text.13434c003ced">例如 gemma-4-e4b-it</x:String>
  <x:String x:Key="Text.160fa36bfe38">翻译提供商</x:String>
  <x:String x:Key="Text.17b67e10f03b">固定结果卡</x:String>
  <x:String x:Key="Text.1bd1893c0900">准备就绪</x:String>
  <x:String x:Key="Text.1f06472ae882">Google 翻译凭据：正在检查安全存储…</x:String>
  <x:String x:Key="Text.1fef86b64588">百度 OCR Secret Key</x:String>
  <x:String x:Key="Text.21a71618bad2">正在检查完整模型包…</x:String>
  <x:String x:Key="Text.23daf4d7881a">百度翻译 APP ID</x:String>
  <x:String x:Key="Text.24cd2dadb9a2">保存所有设置</x:String>
  <x:String x:Key="Text.28137e0aafbe">完全版 · 一键本机多模态模型</x:String>
  <x:String x:Key="Text.2888370272ee">检查处理引擎状态</x:String>
  <x:String x:Key="Text.2b153304b138">测试图片</x:String>
  <x:String x:Key="Text.2cd0f3be8738">取消</x:String>
  <x:String x:Key="Text.2e8a27d3a971">复制原文</x:String>
  <x:String x:Key="Text.301e7d783f53">该密钥由你自己的 Google Cloud 项目提供；建议只允许调用 Cloud Vision API 与 Cloud Translation API。截图仅在选择 Google OCR 时上传，翻译只上传识别后的文字。</x:String>
  <x:String x:Key="Text.320990bd5061">隐私边界</x:String>
