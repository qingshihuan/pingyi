  <x:String x:Key="Text.d95bc1d6f25a">检查应用更新</x:String>
  <x:String x:Key="Text.da4ace1c0a46">翻译方式</x:String>
  <x:String x:Key="Text.df3d58c7d84b">设置</x:String>
  <x:String x:Key="Text.dfb699c54378">设置分类</x:String>
