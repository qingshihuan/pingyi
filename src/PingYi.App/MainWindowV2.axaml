<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:PingYi.App"
        x:Class="PingYi.App.MainWindowV2"
        Classes="workspace" Title="屏译"
        Icon="avares://PingYi.App/Assets/pingyi-v2-icon.png"
        Width="1040" Height="720" MinWidth="800" MinHeight="560"
        KeyDown="Workspace_OnKeyDown" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <!-- Existing dashboard code resolves these status tokens by name. -->
    <SolidColorBrush x:Key="TealBrush">#0D9488</SolidColorBrush>
    <SolidColorBrush x:Key="OrangeBrush">#B45309</SolidColorBrush>
    <SolidColorBrush x:Key="SuccessBrushV2">#15803D</SolidColorBrush>
    <SolidColorBrush x:Key="DangerBrushV2">#DC2626</SolidColorBrush>
  </Window.Resources>
  <Window.Styles>
    <StyleInclude Source="avares://PingYi.App/Styles/Workspace.axaml" />
  </Window.Styles>

  <Grid Margin="24" RowDefinitions="Auto,*,Auto" RowSpacing="20">
    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
      <Image Source="avares://PingYi.App/Assets/pingyi-v2-icon.png" Width="40" Height="40" />
      <StackPanel Grid.Column="1" Spacing="2">
        <TextBlock Text="{DynamicResource String.AppName}" FontSize="20" FontWeight="Bold" />
        <TextBlock Text="{x:Static local:WorkspaceText.Workspace}" Classes="workspace-help" />
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <Border Classes="chip">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Border x:Name="TopStatusDot" Width="8" Height="8" CornerRadius="4"
                    Background="{DynamicResource TealBrush}" VerticalAlignment="Center" />
            <TextBlock x:Name="TopStatusText" Text="正在检查" FontSize="12"
                       AutomationProperties.LiveSetting="Polite" />
          </StackPanel>
        </Border>
        <Button Classes="secondary" Content="{x:Static local:WorkspaceText.Settings}"
                Click="OpenSettingsButton_OnClick" ToolTip.Tip="Ctrl+,"
                AutomationProperties.Name="打开屏译设置" />
      </StackPanel>
    </Grid>

    <ScrollViewer Grid.Row="1" Classes="workspace-page">
      <StackPanel Spacing="16" Margin="0,0,4,0">
        <Grid ColumnDefinitions="3*,2*" ColumnSpacing="16">
          <Border Classes="workspace-card">
            <StackPanel Spacing="18">
              <Border Width="52" Height="52" CornerRadius="14"
                      Background="{DynamicResource SubtleBackgroundBrush}" HorizontalAlignment="Left">
                <Path Width="26" Height="26" Stretch="Uniform" StrokeThickness="1.8"
                      Stroke="{DynamicResource BrandBrush}"
                      Data="M3 8V3H8 M16 3H21V8 M21 16V21H16 M8 21H3V16 M7 9H17 M7 13H17 M7 17H13" />
              </Border>
              <StackPanel Spacing="8">
                <TextBlock Text="{x:Static local:WorkspaceText.CaptureTitle}" Classes="workspace-title" />
                <TextBlock Text="{x:Static local:WorkspaceText.CaptureHint}" Classes="workspace-help" />
              </StackPanel>
              <Button x:Name="CaptureButtonV2" Classes="workspace-capture" HorizontalAlignment="Stretch"
                      Click="CaptureButton_OnClick" AutomationProperties.Name="开始截图识别和翻译">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <TextBlock Text="{DynamicResource String.StartCapture}" VerticalAlignment="Center" />
                  <Border Grid.Column="1" Background="#20FFFFFF" CornerRadius="6" Padding="8,4">
                    <TextBlock x:Name="CaptureHotkeyText" Text="Ctrl  Alt  D" FontSize="12" VerticalAlignment="Center" />
                  </Border>
                </Grid>
              </Button>
              <TextBlock Text="{x:Static local:WorkspaceText.CaptureSteps}" Classes="workspace-label" />
              <TextBlock Text="{x:Static local:WorkspaceText.CaptureTip}" Classes="workspace-help" />
            </StackPanel>
          </Border>
          <StackPanel Grid.Column="1" Spacing="16">
            <Border Classes="workspace-card" Padding="20">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBlock Text="本地模型" Classes="workspace-section" />
                  <Border Grid.Column="1" x:Name="ModelStatusDot" Width="8" Height="8" CornerRadius="4"
                          Background="{DynamicResource TealBrush}" VerticalAlignment="Center" />
                </Grid>
                <TextBlock x:Name="ModelStatusTitleText" Text="正在检查" Classes="workspace-label" />
                <TextBlock x:Name="ModelStatusDetailText" Text="启动时校验离线模型" Classes="workspace-help" />
                <Button x:Name="RefreshWorkspaceButton" Classes="ghost" HorizontalAlignment="Left" Padding="0,6"
                        Content="{x:Static local:WorkspaceText.Refresh}" Click="RefreshWorkspaceButton_OnClick"
                        ToolTip.Tip="F5" AutomationProperties.Name="刷新模型与服务状态" />
              </StackPanel>
            </Border>
            <Border Classes="workspace-card" Padding="20">
              <StackPanel Spacing="10">
                <TextBlock Text="隐私边界" Classes="workspace-section" />
                <TextBlock x:Name="PrivacySummaryText" Text="正在读取当前方案的数据范围" Classes="workspace-help" />
                <TextBlock Text="{x:Static local:WorkspaceText.NoHistory}" Classes="workspace-label" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>

        <Border Classes="workspace-card" Padding="20">
          <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="16" ColumnSpacing="16">
            <StackPanel Spacing="4">
              <TextBlock Text="当前方案" Classes="workspace-help" />
              <TextBlock x:Name="ModeSummaryText" Text="本地优先" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1" Classes="secondary" VerticalAlignment="Center"
                    Content="{x:Static local:WorkspaceText.QuickSwitch}"
                    AutomationProperties.Name="快速切换处理方案">
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedRight">
                  <MenuItem Header="本地优先 · PaddleOCR + Argos" Click="LocalFirstMenuItem_OnClick" />
                  <MenuItem Header="本机大模型翻译 · PaddleOCR + 兼容接口" Click="LocalLlmMenuItem_OnClick" />
                  <MenuItem Header="本机多模态 · PaddleOCR + 大模型纠错" Click="LocalMultimodalMenuItem_OnClick" />
                  <MenuItem Header="云端增强 · 百度 OCR + 百度翻译" Click="CloudModeMenuItem_OnClick" />
                  <MenuItem Header="自定义组合…" Click="CustomModeMenuItem_OnClick" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
            <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="*,*" ColumnSpacing="12">
              <Border Classes="workspace-inset" Padding="14,10">
                <StackPanel Spacing="4">
                  <TextBlock Text="文字识别" Classes="workspace-help" />
                  <TextBlock x:Name="OcrSummaryText" Text="本地 PaddleOCR" FontWeight="SemiBold" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Classes="workspace-inset" Padding="14,10">
                <StackPanel Spacing="4">
                  <TextBlock Text="翻译方式" Classes="workspace-help" />
                  <TextBlock x:Name="TranslationSummaryText" Text="本地 Argos" FontWeight="SemiBold" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </Grid>
          </Grid>
        </Border>

        <Border x:Name="RecoveryBorder" IsVisible="False" Background="{DynamicResource WarningBackgroundBrush}"
                BorderBrush="{DynamicResource DangerBrushV2}" BorderThickness="1" CornerRadius="12" Padding="16">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <StackPanel Spacing="4">
              <TextBlock Text="当前方案需要处理" Classes="workspace-section" />
              <TextBlock x:Name="RecoveryDetailText" Text="请检查模型或服务配置。"
                         Classes="workspace-help" AutomationProperties.LiveSetting="Assertive" />
            </StackPanel>
            <Button Grid.Column="1" Classes="secondary" Content="立即修复" VerticalAlignment="Center"
                    Click="RepairButton_OnClick" AutomationProperties.Name="打开设置修复问题" />
          </Grid>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
        <Border x:Name="LiveStatusDot" Width="8" Height="8" CornerRadius="4"
                Background="{DynamicResource TealBrush}" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Spacing="3">
          <TextBlock x:Name="LiveStatusTitleText" Text="准备就绪" Classes="workspace-label" />
          <TextBlock x:Name="LiveStatusDetailText" Text="按 Ctrl+Alt+D 或点击“开始截图”。"
                     Classes="workspace-help" MaxHeight="64" TextTrimming="CharacterEllipsis"
                     ToolTip.Tip="{Binding Text, RelativeSource={RelativeSource Self}}"
                     AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
