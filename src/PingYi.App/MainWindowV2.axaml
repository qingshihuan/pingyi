<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:PingYi.App" x:Class="PingYi.App.MainWindowV2" Classes="workspace" Title="屏译" Icon="avares://PingYi.App/Assets/pingyi-v2-icon.png" Width="1040" Height="720" MinWidth="800" MinHeight="560" KeyDown="Workspace_OnKeyDown" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <SolidColorBrush x:Key="TealBrush">#2C9A5E</SolidColorBrush>
    <SolidColorBrush x:Key="OrangeBrush">#BB771E</SolidColorBrush>
    <SolidColorBrush x:Key="SuccessBrushV2">#2C9A5E</SolidColorBrush>
    <SolidColorBrush x:Key="DangerBrushV2">#D74750</SolidColorBrush>
  </Window.Resources>
  <Window.Styles>
    <StyleInclude Source="avares://PingYi.App/Styles/Workspace.axaml"/>
  </Window.Styles>
  <Grid RowDefinitions="76,*,Auto">
    <Grid Margin="32,20,32,16" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
      <Image Source="avares://PingYi.App/Assets/pingyi-v2-icon-512.png" Width="34" Height="34"/>
      <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
        <TextBlock Text="{DynamicResource String.AppName}" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock Text="{x:Static local:WorkspaceText.Reading}" Classes="workspace-help" FontSize="12"/>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
          <Border x:Name="TopStatusDot" Width="6" Height="6" CornerRadius="3" Background="{DynamicResource TealBrush}" VerticalAlignment="Center"/>
          <TextBlock x:Name="TopStatusText" Text="正在检查" Classes="workspace-help" FontSize="12" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
        <Button Classes="toolbar-action" Click="OpenSettingsButton_OnClick" ToolTip.Tip="Ctrl+," AutomationProperties.Name="打开屏译设置">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <Path Classes="symbol" Width="15" Height="15" Stroke="{DynamicResource SecondaryTextBrush}" Data="M4 5H20 M4 12H20 M4 19H20 M8 2V8 M16 9V15 M10 16V22"/>
            <TextBlock Text="{x:Static local:WorkspaceText.Settings}" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>
    <ScrollViewer Grid.Row="1" Classes="workspace-page">
      <StackPanel Margin="32,6,32,20" Spacing="14">
        <Border Classes="workspace-card" Padding="28,24" CornerRadius="24" Background="{DynamicResource HeroBackgroundBrush}">
          <Grid ColumnDefinitions="1.3*,*" ColumnSpacing="24">
            <StackPanel Spacing="12" VerticalAlignment="Center" MaxWidth="400" HorizontalAlignment="Left">
              <TextBlock Text="{x:Static local:WorkspaceText.Workspace}" Classes="workspace-help" FontSize="12" Foreground="{DynamicResource BrandBrush}"/>
              <TextBlock Text="{x:Static local:PolishText.CaptureShortTitle}" FontSize="30" LineHeight="39" FontWeight="SemiBold" LetterSpacing="-0.5" TextWrapping="Wrap"/>
              <TextBlock Text="{x:Static local:PolishText.CaptureShortHint}" Classes="workspace-help" MaxWidth="370" HorizontalAlignment="Left"/>
              <Button x:Name="CaptureButtonV2" Classes="workspace-capture" HorizontalAlignment="Stretch" Margin="0,4,0,0" Click="CaptureButton_OnClick" AutomationProperties.Name="开始截图识别和翻译">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                  <Path Classes="symbol" Stroke="White" Data="M3 8V3H8 M16 3H21V8 M21 16V21H16 M8 21H3V16"/>
                  <TextBlock Grid.Column="1" Text="{DynamicResource String.StartCapture}" VerticalAlignment="Center"/>
                  <Border Grid.Column="2" Background="#24FFFFFF" CornerRadius="5" Padding="7,4">
                    <TextBlock x:Name="CaptureHotkeyText" Text="Ctrl  Alt  D" FontSize="11" VerticalAlignment="Center"/>
                  </Border>
                </Grid>
              </Button>
              <TextBlock Text="{x:Static local:PolishText.CaptureCancelHint}" Classes="workspace-help" FontSize="11" LineHeight="16"/>
            </StackPanel>
            <!-- Original static vector illustration; no user content or rendering loop. -->
            <Viewbox Grid.Column="1" MaxWidth="270" Stretch="Uniform" Margin="0,4,6,0" IsHitTestVisible="False">
              <Grid Width="264" Height="206">
                <Border Width="190" Height="190" CornerRadius="95" Background="{DynamicResource HeroAccentBrush}" Opacity="0.45" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Border Width="134" Height="142" Margin="13,9,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="19" Background="{DynamicResource HeroPaperBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" BoxShadow="0 7 18 0 #0B102A50" RenderTransformOrigin="50%,50%">
                  <Border.RenderTransform>
                    <RotateTransform Angle="-8"/>
                  </Border.RenderTransform>
                  <StackPanel Margin="21,15" Spacing="10">
                    <TextBlock Text="A" FontSize="42" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <Border Height="5" CornerRadius="2" Background="{DynamicResource HeroLineBrush}"/>
                    <Border Height="5" Width="64" HorizontalAlignment="Left" CornerRadius="2" Background="{DynamicResource HeroLineBrush}"/>
                  </StackPanel>
                </Border>
                <Border Width="134" Height="138" Margin="0,0,11,6" HorizontalAlignment="Right" VerticalAlignment="Bottom" CornerRadius="21" Background="{DynamicResource ActionFillBrush}" BorderBrush="#40FFFFFF" BorderThickness="1" BoxShadow="0 10 20 0 #16065BB8" RenderTransformOrigin="50%,50%">
                  <Border.RenderTransform>
                    <RotateTransform Angle="7"/>
                  </Border.RenderTransform>
                  <StackPanel Margin="21,14" Spacing="10">
                    <TextBlock Text="文" FontSize="38" FontWeight="SemiBold" Foreground="White"/>
                    <Border Height="5" CornerRadius="2" Background="#70FFFFFF"/>
                    <Border Height="5" Width="56" HorizontalAlignment="Left" CornerRadius="2" Background="#40FFFFFF"/>
                  </StackPanel>
                </Border>
                <Border Width="38" Height="38" CornerRadius="19" Margin="108,76,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{DynamicResource HeroPaperBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" BoxShadow="0 3 9 0 #13000000">
                  <Path Classes="symbol" Width="16" Height="16" Data="M4 7H20 M15 3L20 7L15 11 M20 17H4 M9 13L4 17L9 21"/>
                </Border>
              </Grid>
            </Viewbox>
          </Grid>
        </Border>
        <Border Classes="workspace-card" Padding="22,16" CornerRadius="16">
          <Grid RowDefinitions="Auto,Auto" RowSpacing="14">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
              <TextBlock Text="{x:Static local:WorkspaceText.ProcessLabel}" Classes="workspace-help" FontSize="12" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" x:Name="ModeSummaryText" Text="本地优先" Classes="workspace-label" VerticalAlignment="Center"/>
              <Button Grid.Column="2" Classes="toolbar-action" MinHeight="30" Padding="12,4" Content="{x:Static local:WorkspaceText.QuickSwitch}" AutomationProperties.Name="快速切换处理方案">
                <Button.Flyout>
                  <MenuFlyout Placement="BottomEdgeAlignedRight">
                    <MenuItem Header="本地优先 · PaddleOCR + Argos" Click="LocalFirstMenuItem_OnClick"/>
                    <MenuItem Header="本机大模型翻译 · PaddleOCR + 兼容接口" Click="LocalLlmMenuItem_OnClick"/>
                    <MenuItem Header="本机多模态 · PaddleOCR + 大模型纠错" Click="LocalMultimodalMenuItem_OnClick"/>
                    <MenuItem Header="云端增强 · 百度 OCR + 百度翻译" Click="CloudModeMenuItem_OnClick"/>
                    <MenuItem Header="自定义组合…" Click="CustomModeMenuItem_OnClick"/>
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
            </Grid>
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto,*" ColumnSpacing="22">
              <StackPanel Spacing="4">
                <TextBlock Text="文字识别" Classes="workspace-help" FontSize="12"/>
                <TextBlock x:Name="OcrSummaryText" Text="本地 PaddleOCR" Classes="workspace-section"/>
              </StackPanel>
              <Path Grid.Column="1" Classes="symbol" Stroke="{DynamicResource TertiaryTextBrush}" Width="24" Data="M3 12H21 M16 7L21 12L16 17"/>
              <StackPanel Grid.Column="2" Spacing="4">
                <TextBlock Text="翻译方式" Classes="workspace-help" FontSize="12"/>
                <TextBlock x:Name="TranslationSummaryText" Text="本地 Argos" Classes="workspace-section"/>
              </StackPanel>
            </Grid>
          </Grid>
        </Border>
        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
          <Border Classes="workspace-card" Padding="18,15" Grid.Column="0" CornerRadius="16">
            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <Border Classes="symbol-tile">
                  <Path Classes="symbol" Data="M5 7L12 3L19 7V17L12 21L5 17Z M5 7L12 11L19 7 M12 11V21"/>
                </Border>
                <TextBlock Grid.Column="1" Text="本地模型" Classes="workspace-section" VerticalAlignment="Center"/>
                <Border Grid.Column="2" x:Name="ModelStatusDot" Width="6" Height="6" CornerRadius="3" Background="{DynamicResource TealBrush}" VerticalAlignment="Center"/>
              </Grid>
              <StackPanel Grid.Row="1" Spacing="7" VerticalAlignment="Center">
                <TextBlock x:Name="ModelStatusTitleText" Text="正在检查" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="ModelStatusDetailText" Text="启动时校验离线模型" Classes="workspace-help" FontSize="12" LineHeight="18"/>
              </StackPanel>
              <Button Grid.Row="2" x:Name="RefreshWorkspaceButton" Classes="ghost" HorizontalAlignment="Left" Padding="0,4" MinHeight="28" Click="RefreshWorkspaceButton_OnClick" ToolTip.Tip="F5" AutomationProperties.Name="刷新模型与服务状态">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="{x:Static local:WorkspaceText.Refresh}" FontSize="12" Foreground="{DynamicResource BrandBrush}"/>
                  <Path Classes="symbol" Width="12" Height="12" Data="M20 10A8 8 0 1 0 19 17 M20 10V4 M20 10H14"/>
                </StackPanel>
              </Button>
            </Grid>
          </Border>
          <Border Classes="workspace-card" Padding="18,15" Grid.Column="1" CornerRadius="16">
            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Border Classes="symbol-tile" Background="{DynamicResource SuccessBackgroundBrush}">
                  <Path Classes="symbol" Stroke="{DynamicResource SuccessTextBrush}" Data="M12 3L20 7V12C20 17 16 20 12 21C8 20 4 17 4 12V7Z M8 12L11 15L16 9"/>
                </Border>
                <TextBlock Grid.Column="1" Text="隐私边界" Classes="workspace-section" VerticalAlignment="Center"/>
              </Grid>
              <TextBlock Grid.Row="1" x:Name="PrivacySummaryText" Text="正在读取当前方案的数据范围" Classes="workspace-help" FontSize="12" LineHeight="18" VerticalAlignment="Center"/>
              <TextBlock Grid.Row="2" Text="{x:Static local:WorkspaceText.NoHistory}" Classes="workspace-label" FontSize="11"/>
            </Grid>
          </Border>
        </Grid>
        <Border x:Name="RecoveryBorder" IsVisible="False" Background="{DynamicResource WarningBackgroundBrush}" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1" CornerRadius="14" Padding="16">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <StackPanel Spacing="4">
              <TextBlock Text="当前方案需要处理" Classes="workspace-section"/>
              <TextBlock x:Name="RecoveryDetailText" Text="请检查模型或服务配置。" Classes="workspace-help" AutomationProperties.LiveSetting="Assertive"/>
            </StackPanel>
            <Button Grid.Column="1" Classes="secondary" Content="立即修复" VerticalAlignment="Center" Click="RepairButton_OnClick" AutomationProperties.Name="打开设置修复问题"/>
          </Grid>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="32,12,32,16">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
        <Border x:Name="LiveStatusDot" Width="6" Height="6" CornerRadius="3" Background="{DynamicResource TealBrush}" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="1" Spacing="2">
          <TextBlock x:Name="LiveStatusTitleText" Text="准备就绪" Classes="workspace-label" FontSize="12"/>
          <TextBlock x:Name="LiveStatusDetailText" Text="按 Ctrl+Alt+D 或点击“开始截图”。" Classes="workspace-help" FontSize="11" LineHeight="17" MaxHeight="51" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Text, RelativeSource={RelativeSource Self}}" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>

